:root{--muted:#647580}
.person-copy p,.job-info p,.metric-label,.metric-foot,.list-meta,.pagination,.list-note,.detail-top,.detail-identity p,.criterion-quote,.footer-hint,.bottom-strip,.tag,.profile-body p,.field-hint,.page-note,.job-company,.job-criteria p{color:#647580}
.candidate-table th{color:#637581}.status{font-size:14px;background:#edf1f4;color:#586a77}.status.complete{background:#eaf6ee;color:#326b4b}.status.review{background:#fff4e3;color:#8e5e1f}.status.partial{background:#eef3f9;color:#4e6b8a}.criterion-title .mini-status{color:#48775f}.criterion-title .mini-status.amber{color:#93672c}.detail-summary p{color:#567363}.detail-summary.review p{color:#8b6b3b}.detail-summary.review .summary-title{color:#8d611f}.coverage span{color:#647580}.tab{color:#627681}.detail-body .evidence-link{font-size:13px}.nav-item>span:not(.nav-count){white-space:nowrap}.search input::placeholder{color:#71818d}.job-select{color:#5e707c}.empty-state p{font-size:15px}.modal-content>p,.modal-lead{color:#637581}.source-interpretation p,.requirements-full p{color:#647580}.selection-bar .btn:disabled{opacity:.6}.btn:focus-visible,.icon-btn:focus-visible{outline-offset:3px}
@media(min-width:721px){.mobile-menu{display:none!important}}
.review-grid>div,.review-grid>.detail-panel{min-width:0}.list-panel{min-width:0}.tab{flex-shrink:0}
@media(max-width:1050px){.review-grid{grid-template-columns:minmax(0,1fr)}}
@media(max-width:720px){.candidate-table .status{font-size:12px}.candidate-table .person-name{font-size:14px}.candidate-table td:nth-child(4){padding-left:4px;padding-right:4px}.detail-identity p{font-size:14px}.detail-identity h2{line-height:1.4}.source-quote{font-size:16px}.modal-content .callout{font-size:14px}.search input{min-height:24px}.icon-btn{min-width:38px;min-height:38px}}
